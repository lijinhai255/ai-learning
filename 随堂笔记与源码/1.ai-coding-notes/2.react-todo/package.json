{
  "name": "react-vue-nest-todo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @todo/web-react dev",
    "dev:react": "pnpm --filter @todo/web-react dev",
    "dev:vue": "pnpm --filter @todo/web-vue dev",
    "dev:api": "pnpm --filter @todo/api-nest dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter @todo/domain test:unit && pnpm --filter @todo/web-react test:unit && pnpm --filter @todo/web-vue test:unit && pnpm --filter @todo/api-nest test:unit",
    "test:e2e": "pnpm --filter @todo/e2e test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "spellcheck": "cspell --config cspell.json --no-progress \"**/*.{ts,tsx,vue,md,json,yml,yaml}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm spellcheck && pnpm test:unit && pnpm build",
    "verify:all": "pnpm verify && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.1",
    "cspell": "^8.17.5",
    "eslint": "^9.20.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "vitest": "^3.0.9"
  }
}
